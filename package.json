{
  "name": "historic-map-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "probe:sources": "node scripts/probe-heritage-sources.mjs",
    "probe:tiles": "node scripts/probe-historical-tiles.mjs",
    "build:places": "node scripts/build-place-index.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "measure:time-lapse": "node scripts/measure-time-lapse.mjs",
    "budget": "node scripts/check-bundle-budget.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "check": "pnpm test && pnpm build && pnpm budget",
    "check:all": "pnpm check && pnpm test:e2e"
  },
  "dependencies": {
    "@vercel/og": "^0.11.1",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
